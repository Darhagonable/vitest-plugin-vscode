{
  "name": "vitest-plugin-vscode",
  "version": "0.0.0",
  "license": "MIT",
  "private": false,
  "type": "module",
  "description": "Vitest plugin that runs VS Code extension tests inside a real extension host.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darhagonable/vitest-plugin-vscode.git"
  },
  "bugs": "https://github.com/Darhagonable/vitest-plugin-vscode/issues",
  "homepage": "https://github.com/Darhagonable/vitest-plugin-vscode#readme",
  "author": "Darhagonable",
  "keywords": [
    "vitest",
    "vscode",
    "vs-code",
    "extension",
    "extension-host",
    "plugin",
    "testing",
    "integration-testing"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@vscode/test-electron": "^3.0.0",
    "devalue": "^6.0.0"
  },
  "peerDependencies": {
    "vitest": ">=5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/vscode": "^1.120.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:sample-extension": "vitest run --root tests/_sample-extension"
  },
  "packageManager": "pnpm@11.28.9+sha512.35421cea2720eca3f5ad722b67e8ef18f4d3cd4745ed2fcfeb0dc288d4e9437fad3870d91ee6e83f268f0f6f7e0f62723317b19617bb45ee4333172ef51159f8"
}
